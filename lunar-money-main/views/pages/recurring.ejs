<% title = "Lunar Money - Recurring Transactions" %>

<div class="container py-4">
	<h2 class="mb-4">Recurring Transactions</h2>

	<div class="card p-4 mt-4 shadow-sm">
		<div class="card-header d-flex justify-content-between align-items-center">
			<h5 class="mb-0">Recurring Transactions</h5>
			<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRecurringModal">Add
				Recurring</button>
		</div>
		<div class="mb-3 card-body">
			<div class="table-responsive">
				<% if (recurring.length > 0) { %>
				<table class="table custom-table-striped table-bordered align-middle table-sm">
					<thead class="custom-table-striped" id="custom-table-header">
						<tr>
							<th>Next Date</th>
							<th>Name</th>
							<th>Tags</th>
							<th>Amount</th>
							<th>Frequency</th>
						</tr>
					</thead>
					<tbody>
						<% recurring.forEach(item => { %>
						<tr class="recurring-row" data-id="<%= item._id %>" data-name="<%= item.name %>"
							data-amount="<%= item.amount %>" data-date="<%= item.nextDate %>"
							data-tag="<%= item.tag || '' %>" data-frequency="<%= item.frequency %>">
							<td><%= item.displayDate %></td>
							<td><%= item.name %></td>
							<td class="text-truncate" style="max-width: 200px;">
								<%= item.tag || '' %>
							</td>
							<td class="<%= item.amount >= 0 ? 'text-success' : 'text-danger' %>">
								<%= item.displayAmount %>
							</td>
							<td><%= item.frequency.charAt(0).toUpperCase() + item.frequency.slice(1) %></td>
						</tr>
						<% }) %>
					</tbody>
				</table>
				<% } else { %>
				<p class="fs-5 fst-italic">No recurring transactions yet.</p>
				<% } %>
			</div>
		</div>
	</div>


</div>

<!-- Add/Edit Recurring Modal -->
<div class="modal fade" id="newRecurringModal" tabindex="-1">
	<div class="modal-dialog">
		<form class="modal-content" id="recurringForm" method="POST" action="/recurring">
			<div class="modal-header">
				<h5 class="modal-title">Add Recurring Transaction</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="edit-rec-id" name="id" />

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="new-rec-date">Next Date</label>
					<div class="col-sm-8">
						<input type="date" id="new-rec-date" name="nextDate" class="form-control" required>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="new-rec-name">Name</label>
					<div class="col-sm-8">
						<input type="text" id="new-rec-name" name="name" class="form-control" required>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="new-rec-category">Tags</label>
					<div class="col-sm-8">
						<input type="text" id="new-rec-category" name="tag" class="form-control">
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="new-rec-frequency">Frequency</label>
					<div class="col-sm-8">
						<select id="new-rec-frequency" name="frequency" class="form-select" required>
							<option value="daily">Daily</option>
							<option value="weekly">Weekly</option>
							<option value="monthly">Monthly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
				</div>

				<div class="row mb-3 align-items-center position-relative">
					<label class="col-sm-4 col-form-label" for="new-rec-amount">Amount</label>
					<div class="col-sm-8 d-flex gap-2">
						<input id="new-rec-amount" name="amount" type="number" step="0.01" class="form-control"
							value="0.00" required>
						<button type="button" id="new-rec-amount-type-toggle"
							class="btn btn-outline-success btn-sm">Income</button>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="new-rec-notify">Notify?</label>
					<div class="col-sm-8 d-flex gap-2">
						<input id="new-rec-notify" name="notify" type="checkbox">
						<input id="new-rec-notify-days" name="notifyDaysBefore" type="number" min="0"
							class="form-control" placeholder="Days before">
					</div>
				</div>

			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>

		</form>
	</div>
</div>

<!-- Edit Recurring Modal -->
<div class="modal fade" id="editRecurringModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<form id="deleteRecurringForm" method="POST">
				<input type="hidden" name="_method" value="DELETE" />
				<div class="modal-header d-flex align-items-center justify-content-between">
					<h5 class="modal-title">Edit Transaction</h5>
					<button type="submit" class="btn btn-danger btn-sm">
						Delete
					</button>
				</div>
			</form>
		</div>
		<form class="modal-content" id="editRecurringForm" method="POST">
			<div class="modal-header">
				<h5 class="modal-title">Edit Recurring Transaction</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="edit-recurring-id" name="id" />

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="edit-rec-date">Next Date</label>
					<div class="col-sm-8">
						<input type="date" id="edit-rec-date" name="nextDate" class="form-control" required>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="edit-rec-name">Name</label>
					<div class="col-sm-8">
						<input type="text" id="edit-rec-name" name="name" class="form-control" required>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="edit-rec-category">Tags</label>
					<div class="col-sm-8">
						<input type="text" id="edit-rec-category" name="tag" class="form-control">
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="edit-rec-frequency">Frequency</label>
					<div class="col-sm-8">
						<select id="edit-rec-frequency" name="frequency" class="form-select" required>
							<option value="daily">Daily</option>
							<option value="weekly">Weekly</option>
							<option value="monthly">Monthly</option>
							<option value="yearly">Yearly</option>
						</select>
					</div>
				</div>

				<div class="row mb-3 align-items-center position-relative">
					<label class="col-sm-4 col-form-label" for="edit-rec-amount">Amount</label>
					<div class="col-sm-8 d-flex gap-2">
						<input id="edit-rec-amount" name="amount" type="number" step="0.01" class="form-control"
							required>
						<button type="button" id="edit-rec-amount-type-toggle"
							class="btn btn-outline-success btn-sm">Income</button>
					</div>
				</div>

				<div class="row mb-3 align-items-center">
					<label class="col-sm-4 col-form-label" for="edit-rec-notify">Notify?</label>
					<div class="col-sm-8 d-flex gap-2">
						<input id="edit-rec-notify" name="notify" type="checkbox">
						<input id="edit-rec-notify-days" name="notifyDaysBefore" type="number" min="0"
							class="form-control" placeholder="Days before">
					</div>
				</div>

			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>

		</form>
	</div>
</div>

<script src="/recurringModals.js"></script>